# Base URL of the SmartSeed API (include /v1 prefix is NOT needed; client adds /v1/public/...)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Comma-separated hosts accepted in scanned QR URLs (https://<host>/verify/<token>)
EXPO_PUBLIC_VERIFY_HOSTS=smartseed.example
# Optional: EAS project id for Expo push tokens
EXPO_PUBLIC_EAS_PROJECT_ID=
