# Copy to .env (never commit). Generate secrets with: node scripts/genKeys.mjs
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Application role (RLS-bound, no BYPASSRLS). Local compose maps Postgres to 5433.
DATABASE_URL=postgres://smartseed_app:smartseed_app@localhost:5433/smartseed
# Owner/migrator role, used only by `npm run migrate`
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/smartseed
REDIS_URL=redis://localhost:6379

# --- security (generate with scripts/genKeys.mjs; production: secret manager) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=smartseed
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
METRICS_TOKEN=            # >= 16 chars; /metrics is disabled when unset

# --- public verification / QR ---
PUBLIC_VERIFY_BASE_URL=https://smartseed.example

# --- AI detection service (services/ai) ---
AI_SERVICE_URL=http://localhost:8000
AI_SHARED_SECRET=         # same value as the AI service's AI_SHARED_SECRET

# --- investigation agent (optional; without it an evidence-only rule report is produced) ---
ANTHROPIC_API_KEY=
INVESTIGATION_MODEL=claude-sonnet-5-5

# --- notifications ---
SMTP_URL=                 # e.g. smtps://user:pass@smtp.example.com:465 ; required in production
EMAIL_FROM=SmartSeed <no-reply@smartseed.example>

# --- Hyperledger Fabric (infra/fabric/README.md). Without these the worker keeps ledger records PENDING ---
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_TLS_CA_PATH=
FABRIC_PEER_HOST_ALIAS=
FABRIC_CHANNEL=seedchannel
FABRIC_CHAINCODE=smartseed
FABRIC_WALLET_DIR=        # <dir>/<orgId>/{cert.pem,key.pem,mspid}
FABRIC_USE_PDC=false
APP_SIGNING_PRIVATE_KEY=  # ECDSA P-256 PKCS8 PEM (dev); production: KMS/HSM-backed signer

# --- billing (Razorpay; account + compliance set-up required) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=7

# --- rate limits (per IP per window) ---
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PUBLIC_MAX=60
